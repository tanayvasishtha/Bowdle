# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=2567
REGION=local

# Production: Render/Postgres internal URL. Required for accounts that survive restarts.
# DATABASE_URL=postgres://user:pass@host:5432/bowdle

# Single-node durable file DB (dev / small deploy without Postgres). Directory is created if missing.
# PGLITE_DIR=.data/pglite

# Behind Render/nginx so guest rate limits see real client IPs.
# TRUST_PROXY=1

# PUBLIC_URL=https://bowdle.io
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
