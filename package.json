{
  "name": "bowdle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch src/server/main.ts",
    "dev:client": "vite --mode split",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "build": "vite build",
    "build:poki": "vite build --mode poki",
    "build:crazygames": "vite build --mode crazygames",
    "build:portals": "npm run build:poki && npm run build:crazygames && node scripts/portal-check.ts",
    "size": "node scripts/size-check.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run size",
    "e2e": "playwright test",
    "start": "node src/server/main.ts",
    "smoke": "node scripts/prod-smoke.ts"
  },
  "dependencies": {
    "@colyseus/better-call": "1.3.3",
    "@colyseus/core": "0.18.13",
    "@colyseus/schema": "5.0.32",
    "@colyseus/sdk": "0.18.2",
    "@colyseus/ws-transport": "0.18.2",
    "@electric-sql/pglite": "0.5.8",
    "colyseus": "0.18.5",
    "express": "5.2.1",
    "postgres": "3.4.9",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@colyseus/testing": "0.18.5",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "author": "Tanay Vasishtha"
}
